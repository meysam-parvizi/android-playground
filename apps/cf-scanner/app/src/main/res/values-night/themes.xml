<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Dark variant. Inherits the light theme so the type scale, font, and layout
      direction are defined once; only colours are overridden here.
    -->
    <style name="Theme.CfScanner" parent="Theme.CfScanner.Base">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FF2A1500</item>
        <item name="colorPrimaryContainer">#FF6B3400</item>
        <item name="colorOnPrimaryContainer">@color/brand_container</item>

        <item name="colorSecondary">@color/brand</item>
        <item name="colorOnSecondary">#FF2A1500</item>

        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_dark</item>
        <item name="colorOutline">@color/outline_dark</item>

        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

</resources>
