<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares the languages this app ships, for Android's own per-app language
  picker under Settings → System → Languages → App languages. The system reads
  this from API 33 onward; below that it is simply unused.

  `android:defaultLocale` names the language to fall back to when the user's
  preferred one is unsupported.

  This file is *not* what makes the in-app picker work, and it is not what fixed
  the UI opening in the wrong language — that needed a real `res/values-fa/`
  folder, because resource resolution ignores this file entirely. Keeping the two
  in step still matters so the system picker offers exactly the languages the app
  can actually display.

  Keep the list aligned with `LocaleRegistry.SUPPORTED`; `LocaleConfigTest` fails
  the build if they drift apart.
-->
<locale-config
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:defaultLocale="fa">
    <locale android:name="fa" />
    <locale android:name="en" />
</locale-config>
