<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!--
      Both actions live in the overflow.

      Language was a permanent toolbar icon for a setting most users touch once,
      and it cost the title a 48dp slot on every screen. In the overflow it is
      one extra tap and gains a text label, which is clearer than a globe glyph.
    -->
    <item
        android:id="@+id/action_language"
        android:icon="@drawable/ic_language"
        android:title="@string/action_language"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_about"
        android:icon="@drawable/ic_info"
        android:title="@string/action_about"
        app:showAsAction="never" />
</menu>
