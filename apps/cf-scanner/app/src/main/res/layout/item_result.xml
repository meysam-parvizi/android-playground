<?xml version="1.0" encoding="utf-8"?>
<!--
  A ranked result card on a fixed information grid.

  Line 1: IP address                              score pill
  Line 2: rank · datacenter
  Line 3: four equal micro-stats (label above, value below)

  The earlier card put rank, a variable-width IP, datacenter and score on one
  line. The IP alone varies by up to 67dp between valid addresses, so everything
  after it floated horizontally from card to card. Moving metadata to its own
  line makes the IP and score stable columns.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_gap"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:strokeWidth="@dimen/space_hairline"
    app:strokeColor="?attr/colorOutline"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:rippleColor="?attr/colorPrimary">

    <!--
      Direction is pinned to the locale, not inferred.

      Without this, Android resolves each card by its first strong character.
      A card begins with an IP address, whose first strong character is a Latin
      digit, so cards resolved LTR while the Persian UI around them resolved
      RTL — the badge, address and metric order flipped from card to card
      depending on content. The IP keeps its own textDirection="ltr" below; that
      is a property of the address, not of the card holding it.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
            android:padding="@dimen/space_l">

        <!-- Full-width technical identifier; always LTR and copied verbatim. -->
        <TextView
            android:id="@+id/rowIp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_m"
            android:textAppearance="@style/TextAppearance.CfScanner.MonoCompact"
            android:textColor="?attr/colorOnSurface"
            android:textDirection="ltr"
            android:maxLines="2"
            android:lineSpacingExtra="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/rowScore"
            app:layout_constraintTop_toTopOf="parent" />

        <!--
          The one coloured quality signal. The old design repeated quality on the
          rank marker and score, creating competing focal points.
        -->
        <TextView
            android:id="@+id/rowScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="60dp"
            android:background="@drawable/bg_score"
            android:gravity="center"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.CfScanner.LabelLarge"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Metadata stays out of the primary line, so neither field can collide. -->
        <!--
          Rank sits at the opposite edge from the datacenter code.

          The two used to be adjacent, reading "rank 9 VIE" as though it were one
          phrase — two unrelated facts that happened to be next to each other.
          Pushing them to opposite edges of the same line makes it plain they are
          separate, and costs no vertical space.
        -->
        <TextView
            android:id="@+id/rowRank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.CfScanner.Label"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rowScore" />

        <TextView
            android:id="@+id/rowContext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.CfScanner.Label"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:singleLine="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/rowRank"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintBaseline_toBaselineOf="@id/rowRank" />

        <!--
          Four equal micro-stats. A localised label sits above each value, so the
          meaning is explicit without placing Latin units and Persian digits on the
          same visual line as an icon.
        -->
        <TextView
            android:id="@+id/rowPing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.CfScanner.MetricBlock"
            android:maxLines="2"
            android:lineSpacingExtra="2dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/rowJitter"
            app:layout_constraintTop_toBottomOf="@id/rowRank"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintHorizontal_chainStyle="spread_inside" />

        <TextView
            android:id="@+id/rowJitter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.CfScanner.MetricBlock"
            android:maxLines="2"
            android:lineSpacingExtra="2dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            app:layout_constraintStart_toEndOf="@id/rowPing"
            app:layout_constraintEnd_toStartOf="@id/rowLoss"
            app:layout_constraintTop_toTopOf="@id/rowPing"
            app:layout_constraintHorizontal_weight="1" />

        <TextView
            android:id="@+id/rowLoss"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.CfScanner.MetricBlock"
            android:maxLines="2"
            android:lineSpacingExtra="2dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            app:layout_constraintStart_toEndOf="@id/rowJitter"
            app:layout_constraintEnd_toStartOf="@id/rowSpeed"
            app:layout_constraintTop_toTopOf="@id/rowPing"
            app:layout_constraintHorizontal_weight="1" />

        <TextView
            android:id="@+id/rowSpeed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.CfScanner.MetricBlock"
            android:maxLines="2"
            android:lineSpacingExtra="2dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            app:layout_constraintStart_toEndOf="@id/rowLoss"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/rowPing"
            app:layout_constraintHorizontal_weight="1" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
