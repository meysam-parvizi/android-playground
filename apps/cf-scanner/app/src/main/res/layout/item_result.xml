<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutline"
    app:cardBackgroundColor="?attr/colorSurface"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:baselineAligned="false"
        android:gravity="center_vertical">

        <!-- Rank badge, tinted by grade so quality reads at a glance. -->
        <TextView
            android:id="@+id/rowRank"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:background="@drawable/bg_rank"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!-- IP + score on one line -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/rowIp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.CfScanner.Mono"
                    android:textColor="?attr/colorOnSurface"
                    android:textDirection="ltr"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/rowScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Metric chips: compact, scannable, no wall of text. -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/rowChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="2dp"
                app:singleLine="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPing"
                    style="@style/Widget.CfScanner.MetricChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipJitter"
                    style="@style/Widget.CfScanner.MetricChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLoss"
                    style="@style/Widget.CfScanner.MetricChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipColo"
                    style="@style/Widget.CfScanner.MetricChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWs"
                    style="@style/Widget.CfScanner.MetricChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_ws" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
