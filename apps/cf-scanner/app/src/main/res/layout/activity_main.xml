<?xml version="1.0" encoding="utf-8"?>
<!--
  Standard one-line top app bar over a single scrolling list.

  The full English title measures 183dp at 16sp and the Persian one 161dp. On a
  320dp phone, keeping Language visible and moving About into the overflow leaves
  more than 200dp, so both fit without wrapping or a second title row.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layoutDirection="locale"
        app:contentInsetStart="@dimen/space_m"
        app:contentInsetEnd="0dp"
        app:titleMarginStart="0dp"
        app:titleMarginEnd="@dimen/space_s"
        app:title="@string/screen_title"
        app:titleCentered="false"
        app:titleTextAppearance="@style/TextAppearance.CfScanner.ToolbarTitle"
        app:menu="@menu/main_menu" />

    <!--
      One RecyclerView for the whole screen: controls, placeholder and results are
      separate adapters concatenated together. No NestedScrollView, so hundreds of
      result rows are genuinely recycled.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contentList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_l"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_xl"
        android:scrollbars="vertical" />

</LinearLayout>
