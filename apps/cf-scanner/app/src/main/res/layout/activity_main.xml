<?xml version="1.0" encoding="utf-8"?>
<!--
  A plain toolbar over a single scrolling list.

  This replaces a CollapsingToolbarLayout, which was the wrong pattern here. A
  large collapsing title suits an article you read; this screen is a form you
  operate. Two things went wrong with it:

    - It only collapses when the scrolling child actually scrolls. The controls
      live inside the list, so on a short result set nothing scrolled and the
      132dp title sat there permanently.
    - Even when it did collapse, the controls were behind a title the user had
      to scroll past every time they wanted to change a setting.

  A two-line title at 18sp holds the full name in both languages inside about
  72dp, against 188dp for the collapsing version — 116dp returned to the list on
  every screen, portrait and landscape, and it never moves.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:fitsSystemWindows="true">

    <!--
      The title is a child TextView rather than app:title. Toolbar's built-in
      title is single-line and exposes no attribute to change that; setting it
      means reaching into the internal view after the title is applied, which
      breaks quietly when the library changes. A child view makes maxLines an
      ordinary attribute.
    -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="locale"
        android:paddingVertical="@dimen/space_s"
        app:contentInsetStartWithNavigation="0dp"
        app:menu="@menu/main_menu">

        <!--
          layoutDirection on the toolbar is set explicitly rather than
          inherited: it resolves its own child placement, and relying on the
          theme reaching it in time is what left the Persian title drifting
          left once before.
        -->
        <TextView
            android:id="@+id/toolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_title"
            android:textAppearance="@style/TextAppearance.CfScanner.ToolbarTitle"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAlignment="viewStart" />

    </com.google.android.material.appbar.MaterialToolbar>

    <!--
      One RecyclerView for the whole screen: the controls, the placeholder, and
      the results are separate adapters concatenated together.

      This replaces a NestedScrollView wrapping a wrap_content RecyclerView. In
      that arrangement the list is measured unbounded, so it lays out every row
      at full height and recycles nothing — with a few hundred results every
      update touched every row, which is what made scrolling stutter.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contentList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingBottom="@dimen/space_xl"
        android:scrollbars="vertical" />

</LinearLayout>
